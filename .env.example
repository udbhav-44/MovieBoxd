# Copy to .env on the server and fill in. Never commit the real file.

# Subdomain you pointed at this machine. Caddy issues a certificate for it.
DOMAIN=movies.example.com

# Password for the login page. Required — the app is open without it.
APP_PASSWORD=choose-a-long-random-password

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
